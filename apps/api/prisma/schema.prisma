// ==============================================================================
// GUARDIÃO FISCAL — Schema Prisma (Fase 1)
// Regra de ouro: toda tabela de negócio carrega tenantId e toda consulta
// passa pelo filtro automático de tenant (src/prisma/prisma.service.ts).
// audit_logs é append-only: nunca receber UPDATE/DELETE da aplicação.
// ==============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum TenantStatus {
  TRIAL
  ACTIVE
  SUSPENDED
  CANCELED
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
}

enum RegimeTributario {
  SIMPLES_NACIONAL
  LUCRO_PRESUMIDO
  LUCRO_REAL
  MEI
  IMUNE_ISENTA
  OUTRO
}

enum CompanyStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum Department {
  FISCAL
  CONTABIL
  PESSOAL
  FINANCEIRO
  SOCIETARIO
  OUTRO
}

enum Sphere {
  FEDERAL
  ESTADUAL
  MUNICIPAL
  TRABALHISTA
  PREVIDENCIARIA
  OUTRA
}

enum Periodicity {
  MENSAL
  TRIMESTRAL
  SEMESTRAL
  ANUAL
}

enum TaskStatus {
  NAO_INICIADA
  AGUARDANDO_DOCUMENTOS
  EM_ANDAMENTO
  EM_CONFERENCIA
  AGUARDANDO_APROVACAO
  CONCLUIDA
  VENCIDA
  BLOQUEADA
  CANCELADA
}

enum TaskPriority {
  BAIXA
  MEDIA
  ALTA
  CRITICA
}

enum HolidayScope {
  NACIONAL
  ESTADUAL
  MUNICIPAL
}

enum ResponsibleArea {
  INTERNO
  FISCAL
  CONTABIL
  PESSOAL
  FINANCEIRO
}

enum DocumentRequestStatus {
  ABERTA
  PARCIAL
  CONCLUIDA
  CANCELADA
}

enum RequestItemStatus {
  PENDENTE
  RECEBIDO
  APROVADO
  REJEITADO
}

enum NotificationType {
  SOLICITACAO_CRIADA
  LEMBRETE_DOCUMENTO
  DOCUMENTO_RECEBIDO
  DOCUMENTO_REJEITADO
  DOCUMENTO_APROVADO
  GENERICA
}

// ---------------------------------------------------------------------------
// Planos e tenants
// ---------------------------------------------------------------------------

model Plan {
  id           String   @id @default(uuid())
  slug         String   @unique
  name         String
  maxCompanies Int
  maxUsers     Int
  storageMb    Int
  priceCents   Int      @default(0)
  features     Json     @default("[]")
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenants       Tenant[]
  subscriptions Subscription[]

  @@map("plans")
}

model Tenant {
  id           String       @id @default(uuid())
  slug         String       @unique // subdomínio: <slug>.guardiaofiscal.com.br
  razaoSocial  String
  nomeFantasia String?
  cnpj         String?      @unique
  email        String
  phone        String?
  logoUrl      String?
  primaryColor String?
  customDomain String?      @unique
  status       TenantStatus @default(TRIAL)
  planId       String?
  address      Json?
  settings     Json         @default("{}")
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  deletedAt    DateTime?

  plan          Plan?          @relation(fields: [planId], references: [id], onDelete: SetNull)
  users         User[]
  companies     Company[]
  subscriptions Subscription[]

  @@index([status])
  @@map("tenants")
}

model Subscription {
  id                 String             @id @default(uuid())
  tenantId           String
  planId             String
  status             SubscriptionStatus @default(TRIALING)
  trialEndsAt        DateTime?
  currentPeriodStart DateTime           @default(now())
  currentPeriodEnd   DateTime?
  canceledAt         DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan   Plan   @relation(fields: [planId], references: [id])

  @@index([tenantId])
  @@map("subscriptions")
}

// ---------------------------------------------------------------------------
// Usuários, papéis e permissões (RBAC)
// ---------------------------------------------------------------------------

model User {
  id               String    @id @default(uuid())
  tenantId         String? // NULL = superadmin da plataforma
  name             String
  email            String
  passwordHash     String
  isActive         Boolean   @default(true)
  twoFactorEnabled Boolean   @default(false)
  twoFactorSecret  String? // criptografado com ENCRYPTION_KEY (AES-256-GCM)
  lastLoginAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?

  tenant                  Tenant?               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  roles                   UserRole[]
  refreshTokens           RefreshToken[]
  companyResponsibilities CompanyResponsible[]
  responsibleObligations  Obligation[]          @relation("ObligationResponsible")
  responsibleTasks        Task[]                @relation("TaskResponsible")
  taskComments            TaskComment[]
  clientAccesses          CompanyClientAccess[]
  createdRequests         DocumentRequest[]     @relation("RequestCreator")
  reviewedItems           DocumentRequestItem[] @relation("ItemReviewer")
  uploadedDocuments       Document[]            @relation("DocumentUploader")
  notifications           Notification[]

  @@unique([tenantId, email])
  @@index([email])
  @@map("users")
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique // SHA-256 do token; o token em si nunca é persistido
  family    String // detecção de reuso: reuso de token revogado derruba a família
  expiresAt DateTime
  revokedAt DateTime?
  ip        String?
  userAgent String?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([family])
  @@map("refresh_tokens")
}

model Role {
  id          String   @id @default(uuid())
  slug        String   @unique // superadmin | tenant_admin | accountant | client | auditor
  name        String
  description String?
  isSystem    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  permissions RolePermission[]
  users       UserRole[]

  @@map("roles")
}

model Permission {
  id          String  @id @default(uuid())
  slug        String  @unique // ex.: companies.read, companies.write, users.manage
  description String?

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  userId String
  roleId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

// ---------------------------------------------------------------------------
// Empresas atendidas (núcleo — campos completos entram na Fase 2)
// ---------------------------------------------------------------------------

model Company {
  id                 String            @id @default(uuid())
  tenantId           String
  razaoSocial        String
  nomeFantasia       String?
  cnpj               String
  inscricaoEstadual  String?
  inscricaoMunicipal String?
  cnaePrincipal      String?
  cnaesSecundarios   String[]          @default([])
  regimeTributario   RegimeTributario?
  enquadramento      String?
  tipoJuridico       String?
  email              String?
  phone              String?
  uf                 String?           @db.VarChar(2)
  municipio          String?
  dataAbertura       DateTime?
  funcionariosCount  Int?
  status             CompanyStatus     @default(ACTIVE)
  riskLevel          RiskLevel         @default(LOW)
  observacoes        String?
  tags               String[]          @default([])
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  deletedAt          DateTime?

  tenant           Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contacts         CompanyContact[]
  responsibles     CompanyResponsible[]
  obligations      Obligation[]
  tasks            Task[]
  clientAccesses   CompanyClientAccess[]
  documentRequests DocumentRequest[]
  documents        Document[]

  @@unique([tenantId, cnpj])
  @@index([tenantId, status])
  @@map("companies")
}

// tenantId é denormalizado nas tabelas filhas para o filtro automático de
// isolamento; a integridade referencial de tenant flui pela FK de company/task.

model CompanyContact {
  id        String   @id @default(uuid())
  tenantId  String
  companyId String
  name      String
  email     String?
  phone     String?
  role      String? // ex.: sócio, financeiro, RH
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([companyId])
  @@map("company_contacts")
}

model CompanyResponsible {
  id        String          @id @default(uuid())
  tenantId  String
  companyId String
  userId    String
  area      ResponsibleArea
  createdAt DateTime        @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([companyId, area])
  @@index([tenantId])
  @@index([userId])
  @@map("company_responsibles")
}

// ---------------------------------------------------------------------------
// Feriados (base do cálculo de dias úteis). tenantId NULL = feriado nacional
// mantido pela plataforma; tenants cadastram estaduais/municipais próprios.
// ---------------------------------------------------------------------------

model Holiday {
  id        String       @id @default(uuid())
  tenantId  String?
  date      DateTime     @db.Date
  name      String
  scope     HolidayScope
  uf        String?      @db.VarChar(2)
  municipio String?
  createdAt DateTime     @default(now())

  @@index([date])
  @@index([tenantId])
  @@map("holidays")
}

// ---------------------------------------------------------------------------
// Obrigações: template (catálogo global ou do tenant) -> obrigação por empresa
// dueRule (JSON): { day: number | "LAST_DAY" | "LAST_BUSINESS_DAY",
//                   monthOffset: number, adjustment: "NONE"|"ANTICIPATE"|"POSTPONE" }
// ---------------------------------------------------------------------------

model ObligationTemplate {
  id              String             @id @default(uuid())
  tenantId        String? // NULL = catálogo global da plataforma
  slug            String             @unique
  name            String
  description     String?
  department      Department
  sphere          Sphere
  periodicity     Periodicity
  anchorMonth     Int                @default(1) // mês-base p/ trimestral/semestral/anual
  dueRule         Json
  regimes         RegimeTributario[] @default([])
  defaultPriority TaskPriority       @default(MEDIA)
  checklist       Json               @default("[]")
  notes           String?
  isActive        Boolean            @default(true)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  obligations Obligation[]

  @@index([tenantId])
  @@map("obligation_templates")
}

model Obligation {
  id            String       @id @default(uuid())
  tenantId      String
  companyId     String
  templateId    String?
  name          String
  department    Department
  sphere        Sphere
  periodicity   Periodicity
  anchorMonth   Int          @default(1)
  dueRule       Json
  priority      TaskPriority @default(MEDIA)
  checklist     Json         @default("[]")
  responsibleId String?
  active        Boolean      @default(true)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  deletedAt     DateTime?

  company     Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  template    ObligationTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  responsible User?               @relation("ObligationResponsible", fields: [responsibleId], references: [id], onDelete: SetNull)
  tasks       Task[]

  @@index([tenantId, companyId])
  @@index([tenantId, active])
  @@map("obligations")
}

// ---------------------------------------------------------------------------
// Tarefas. Geradas pelo motor de recorrência (obligationId preenchido, com
// unicidade por competência) ou criadas manualmente (obligationId NULL).
// ---------------------------------------------------------------------------

model Task {
  id            String       @id @default(uuid())
  tenantId      String
  companyId     String
  obligationId  String?
  title         String
  description   String?
  department    Department?
  competence    String // formato YYYY-MM
  dueDate       DateTime     @db.Date
  status        TaskStatus   @default(NAO_INICIADA)
  priority      TaskPriority @default(MEDIA)
  responsibleId String?
  checklist     Json         @default("[]")
  startedAt     DateTime?
  completedAt   DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  deletedAt     DateTime?

  company     Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  obligation  Obligation? @relation(fields: [obligationId], references: [id], onDelete: SetNull)
  responsible User?       @relation("TaskResponsible", fields: [responsibleId], references: [id], onDelete: SetNull)
  comments    TaskComment[]

  @@unique([obligationId, competence]) // idempotência do motor de recorrência
  @@index([tenantId, status])
  @@index([tenantId, dueDate])
  @@index([tenantId, companyId])
  @@index([tenantId, responsibleId])
  @@map("tasks")
}

model TaskComment {
  id        String   @id @default(uuid())
  tenantId  String
  taskId    String
  userId    String?
  body      String
  createdAt DateTime @default(now())

  task Task  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([taskId])
  @@map("task_comments")
}

// ---------------------------------------------------------------------------
// Fase 3 — Solicitação de documentos, arquivos (MinIO) e portal do cliente
// ---------------------------------------------------------------------------

/** Vínculo do usuário-cliente (papel client) com as empresas que ele enxerga no portal. */
model CompanyClientAccess {
  id        String   @id @default(uuid())
  tenantId  String
  companyId String
  userId    String
  createdAt DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([companyId, userId])
  @@index([tenantId])
  @@index([userId])
  @@map("company_client_accesses")
}

model DocumentRequest {
  id               String                @id @default(uuid())
  tenantId         String
  companyId        String
  title            String
  message          String?
  competence       String? // YYYY-MM
  dueDate          DateTime?             @db.Date
  status           DocumentRequestStatus @default(ABERTA)
  remindersEnabled Boolean               @default(true)
  createdById      String?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  deletedAt        DateTime?

  company   Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdBy User?                 @relation("RequestCreator", fields: [createdById], references: [id], onDelete: SetNull)
  items     DocumentRequestItem[]
  reminders DocumentReminder[]

  @@index([tenantId, status])
  @@index([tenantId, companyId])
  @@map("document_requests")
}

model DocumentRequestItem {
  id              String            @id @default(uuid())
  tenantId        String
  requestId       String
  name            String
  description     String?
  status          RequestItemStatus @default(PENDENTE)
  rejectionReason String?
  reviewedById    String?
  reviewedAt      DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  request    DocumentRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  reviewedBy User?           @relation("ItemReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  documents  Document[]

  @@index([tenantId])
  @@index([requestId])
  @@map("document_request_items")
}

model Document {
  id            String    @id @default(uuid())
  tenantId      String
  companyId     String
  requestItemId String?
  name          String
  category      String?
  competence    String? // YYYY-MM
  uploadedById  String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  company     Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  requestItem DocumentRequestItem? @relation(fields: [requestItemId], references: [id], onDelete: SetNull)
  uploadedBy  User?                @relation("DocumentUploader", fields: [uploadedById], references: [id], onDelete: SetNull)
  versions    DocumentVersion[]

  @@index([tenantId, companyId])
  @@index([tenantId, competence])
  @@map("documents")
}

/** Versões imutáveis: reenvio do mesmo documento cria versão nova, nunca sobrescreve. */
model DocumentVersion {
  id           String   @id @default(uuid())
  tenantId     String
  documentId   String
  version      Int
  objectKey    String // chave no MinIO (bucket privado; download só por link assinado)
  size         Int
  mimeType     String
  checksum     String // sha256 do conteúdo
  uploadedById String?
  createdAt    DateTime @default(now())

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, version])
  @@index([tenantId])
  @@map("document_versions")
}

/** Registro de lembrete enviado. UNIQUE (requestId, stage) = anti-spam por construção. */
model DocumentReminder {
  id        String   @id @default(uuid())
  tenantId  String
  requestId String
  stage     String // D5 | D3 | D0 | ATRASO_YYYY-MM-DD
  sentAt    DateTime @default(now())

  request DocumentRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@unique([requestId, stage])
  @@index([tenantId])
  @@map("document_reminders")
}

model Notification {
  id          String           @id @default(uuid())
  tenantId    String?
  userId      String?
  type        NotificationType
  title       String
  body        String?
  meta        Json?
  readAt      DateTime?
  emailTo     String?
  emailSentAt DateTime?
  emailError  String?
  createdAt   DateTime         @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([tenantId, userId, readAt])
  @@map("notifications")
}

// ---------------------------------------------------------------------------
// Auditoria (append-only — a aplicação só insere; sem update/delete)
// ---------------------------------------------------------------------------

model AuditLog {
  id        String   @id @default(uuid())
  tenantId  String? // NULL para ações de superadmin fora de tenant
  userId    String?
  action    String // ex.: auth.login, tenants.create, users.update
  entity    String // ex.: Tenant, User, Company
  entityId  String?
  ip        String?
  userAgent String?
  before    Json?
  after     Json?
  createdAt DateTime @default(now())

  @@index([tenantId, createdAt])
  @@index([entity, entityId])
  @@map("audit_logs")
}
